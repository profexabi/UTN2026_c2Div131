<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar</title>

    <link rel="shortcut icon" href="img/favicon.ico" type="image/x-icon">

    <!-- Preset CSS sakura-vader -->
    <link rel="stylesheet" href="https://unpkg.com/sakura.css/css/sakura-vader.css" type="text/css">

    <!-- Ruta archivo CSS externo -->
    <link rel="stylesheet" href="css/styles.css">
</head>

<body>

    <header>
        <div>
            <img id="logo" src="img/logo.jpg" alt="logo">
        </div>
        <nav>
            <ul>
                <li class="lista-enlace">
                    <a href="index.html">Principal</a>
                </li>
                <li class="lista-enlace">
                    <a href="get.html">Obtener</a>
                </li>
                <li class="lista-enlace">
                    <a href="post.html">Crear</a>
                </li>
                <li class="lista-enlace">
                    <a href="put.html">Modificar</a>
                </li>
                <li class="lista-enlace">
                    <a href="delete.html">Eliminar</a>
                </li>
            </ul>
        </nav>
    </header>

    <main>
        <h3 class="titulo-pagina">Obtener producto por id</h3>

        <!-- Formulario obtener producto por id -->
        <form id="getProductForm">
            <label for="idProd">Id producto</label>
            <input type="number" name="id" id="idProd" min="1" required>

            <input type="submit" value="Consultar">
        </form>

        <section id="contenedor-productos"></section>

        <section id="contenedor-form"></section>
    </main>

    <script>
        const contenedorProductos = document.getElementById("contenedor-productos");
        const getProductForm = document.getElementById("getProductForm");
        const contenedorForm = document.getElementById("contenedor-form");
        const urlBase = "http://localhost:3000";



        // Optimizacion 1: Mostramos el mensaje de exito/error visualmente
        function mostrarMensaje(type, message) {
            contenedorProductos.innerHTML = `        
                <p class="mensaje ${type}">${message}</p>
            `;
        }



        // Para mostrar la posible lista de errores, cada uno como un parrafo
        function mostrarListaErrores(array) {
            let htmlErrores = "";

            array.forEach(error => {
                htmlErrores += `<p class="mensaje error">${error}</p>`;
            });

            contenedorProductos.innerHTML = htmlErrores;
        }



        // Optimizacion 2: Hacemos una validacion previa de los datos del <form> en el cliente
        function validarFormulario(data) {
            const errores = []; // Igual que el middleware, creamos un array vacio de errores

            // Verificamos que mandamos todos los campos
            if (!data.name || !data.image || !data.price || !data.category) {
                errores.push("Faltan campos requeridos");
            }

            // Validamos el campo nombre
            if (!data.name || data.name.trim().length < 2) {
                errores.push("El nombre debe tener al menos 2 caracteres");
            }

            // Validamos el campo image
            if (!data.image) {
                errores.push("Debe incluirse una imagen");
            }

            // Validamos el campo precio
            if (typeof data.price !== "number" || data.price <= 0) {
                errores.push("El precio debe ser un numero mayor a 0");
            }

            // Validamos el campo category
            if (!data.category) {
                errores.push("Debe seleccionar una categoria")
            }

            return errores;
        }



        getProductForm.addEventListener("submit", async event => {
            event.preventDefault(); // Evitamos el envio por defecto del formulario

            // Cuando hay un solo valor en un evento, como el idProd, podemos extraerlo asi
            const idProd = event.target.idProd.value.trim(); // form de evento + id del input + valor del id + trim() limpiar espacios
            console.log(idProd);

            // Optimizacion 3: Verificamos si hay un id antes de mandarlo
            if (!idProd) {
                return mostrarMensaje("error", "Ingresa un id valido");
            }


            try {
                const response = await fetch(`${urlBase}/api/products/${idProd}`);
                console.log(response);

                const data = await response.json();

                // Optimizacion 4: Filtramos errores 400 o 500
                if (!response.ok) {
                    return mostrarMensaje("error", data.message);
                    // el return hace que esta funcion termine
                }

                const producto = data.payload[0];

                renderizarProducto(producto);

            } catch (error) {
                console.error("Error al hacer la solicitud: ", error);
                mostrarMensaje("error", "Error al enviar la informacion");
            }
        });

        function renderizarProducto(producto) {

            let htmlProducto = `
                <ul class="listados-container">
                    <li class="li-listados">
                        <img src="${producto.image}" alt="${producto.name}" class="img-listados">
                    </li>
                    <li class="li-listados">
                        Id: ${producto.id} / Nombre: ${producto.name} / <strong>Precio: $${producto.price}</strong>
                    </li>
                    <li class="li-listados">
                        <button id="btn-modificar">Modificar</button>
                    </li>
                </ul>
            `;

            contenedorProductos.innerHTML = htmlProducto;

            const btnModificar = document.getElementById("btn-modificar");

            btnModificar.addEventListener("click", () => {

                const confirmacion = confirm("Queres actualizar este producto?");

                if (!confirmacion) {
                    alert("Modificacion cancelada");

                } else {
                    renderizarFormPut(producto);
                }
            });
        }


        function renderizarFormPut(producto) {
            let htmlForm = `
                <h4>Actualizar producto</h4>

                <form id="updateProductForm">

                    <input type="hidden" name="id" value="${producto.id}">

                    <label for="categoryProd">Categoria</label>
                    <select name="category" id="categoryProd" required>
                        <option value="food">Comida</option>
                        <option value="drink">Bebida</option>
                    </select>

                    <label for="imageProd">Imagen</label>
                    <input type="text" name="image" id="imageProd" value="${producto.image}" required>

                    <label for="nameProd">Nombre</label>
                    <input type="text" name="name" id="nameProd" value="${producto.name}" required>

                    <label for="priceProd">Precio</label>
                    <input type="number" name="price" id="priceProd" min="1" value="${producto.price}" required>

                    <label for="activeProd">Activo</label>
                    <select name="active" id="activeProd" required>
                        <option value="1">Activo</option>
                        <option value="0">Inactivo</option>
                    </select>

                    <input type="submit" value="Actualizar producto">

                </form>
            `;

            contenedorForm.innerHTML = htmlForm;

            const updateProductForm = document.getElementById("updateProductForm");

            updateProductForm.addEventListener("submit", event => {
                // Llamamos a la funcion que hara la peticion PUT y le pasamos el event
                actualizarProducto(event);
            });
        }



        async function actualizarProducto(event) {

            event.preventDefault(); // Evitamos el envio por defecto del formulario

            const formData = new FormData(event.target);

            const formObj = Object.fromEntries(formData.entries());

            // Optimizacion 5: Cambiamos algunos datos del formulario
            formObj.price = Number(formObj.price); // Convertimos el precio en un numero para poder validarlo como tal
            formObj.name = formObj.name.trim();
            console.log(formObj); 
            
            // El objeto con la info del formulario se lo paso a la funcion para validar los campos
            const errores = validarFormulario(formObj); 

            console.log(errores);

            // Si hay errores, mostramos mensaje de error y terminamos aca, no hacemos la peticion
            if (errores.length > 0) {
                return mostrarListaErrores(errores);
            }

            console.table(formObj);

            
            try {
                const response = await fetch(`${urlBase}/api/products`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(formObj)
                });

                console.log(response);

                const data = await response.json();

                if (!response.ok) {
                    console.error(data.message);
                    return mostrarMensaje("error", data.message);
                }

                console.log(data.message);
                contenedorForm.innerHTML = "";
                mostrarMensaje("exito", data.message);


            } catch (error) {
                console.error("Error al enviar los datos");
                mostrarMensaje("error", "Error al enviar la informacion");
            }
        }
    </script>
</body>

</html>